{
  "name": "clinicflow",
  "private": true,
  "scripts": {
    "setup": "npm ci && npm ci --prefix frontend",
    "dev": "npm --prefix frontend run dev -- --host 0.0.0.0",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:migrate": "supabase migration up --local",
    "db:reset": "supabase db reset",
    "db:test": "supabase test db",
    "db:seed": "node scripts/seed-local.mjs",
    "clinic:import": "node scripts/import-verified-clinics.mjs",
    "notify:local": "node scripts/send-local-notifications.mjs",
    "prototype": "npm run db:start && npm run db:migrate && npm run db:seed && npm --prefix frontend run dev -- --open"
  },
  "devDependencies": {
    "nodemailer": "^10.3.1",
    "supabase": "^2.122.1"
  }
}
